@model RegisterViewModel
@{
    ViewBag.Title = "Реєстрація";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Реєстрація клієнта</h1>
        <p class="text-muted">Після реєстрації ви зможете переглядати каталог авто і створювати заявки на підбір.</p>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "card card-body" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.Name, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", autocomplete = "name" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "username" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", type = "tel", autocomplete = "tel" })
                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.Address, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control", autocomplete = "address-level2" })
                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    <div class="form-text">Щонайменше 8 символів.</div>
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-success">Зареєструватися</button>
                @Html.ActionLink("Вже маю обліковий запис", "Login", "Account", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
