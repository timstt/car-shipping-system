@model LoginViewModel
@{
    ViewBag.Title = "Вхід";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Вхід до системи</h1>

        @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "card card-body" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "username", autofocus = "autofocus" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
            </div>
            <button type="submit" class="btn btn-primary w-100">Увійти</button>
        }

        <p class="mt-3 text-muted small">
            Ще не маєте облікового запису? @Html.ActionLink("Зареєструватися як клієнт", "Register", "Account")
        </p>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
