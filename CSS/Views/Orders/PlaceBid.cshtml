@model Order
@{
    ViewBag.Title = "Аукціон — заявка №" + Model.OrderId;
    bool budgetOk = Model.Car.AuctionPrice <= Model.MaxBudget;
    var bids = (List<AuctionBid>)ViewBag.Bids;
    var form = (AuctionBid)ViewBag.Form;
    var pending = bids.FirstOrDefault(b => b.Result == BidResult.Pending);
    double lastOutbid = bids.Where(b => b.Result == BidResult.Outbid).Select(b => b.Amount).DefaultIfEmpty(0).Max();
}

<h1 class="h3 mb-3">Взяти участь в аукціоні</h1>

<div class="card mb-3">
    <div class="card-body">
        <p class="mb-1"><strong>Авто:</strong> @Model.Car.GetDetails()</p>
        <p class="mb-1"><strong>Ціна на аукціоні:</strong> $@Model.Car.AuctionPrice.ToString("N0")</p>
        <p class="mb-0"><strong>Бюджет клієнта:</strong> $@Model.MaxBudget.ToString("N0")</p>
    </div>
</div>

@Html.Partial("_Bids", bids)

@if (!budgetOk && !bids.Any())
{
    <div class="alert alert-danger">
        Бюджет клієнта не дозволяє взяти участь у торгах. Підтвердіть, щоб сповістити клієнта про неуспішну ставку.
    </div>
    using (Html.BeginForm("PlaceBid", "Orders", new { id = Model.OrderId }, FormMethod.Post, new { @class = "d-flex gap-2" }))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Сповістити клієнта</button>
        @Html.ActionLink("Скасувати", "Details", new { id = Model.OrderId }, new { @class = "btn btn-outline-secondary" })
    }
}
else if (pending != null)
{
    <div class="card card-body">
        <p class="mb-2">Ставка <strong>$@pending.Amount.ToString("N0")</strong> на @pending.Auction (лот @pending.LotNumber) очікує результату торгів.
            Вкажіть результат після завершення торгів на сайті аукціону.</p>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var r in new[] { BidResult.Won, BidResult.Outbid, BidResult.Lost })
            {
                using (Html.BeginForm("SetBidResult", "Orders", new { id = pending.AuctionBidId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="result" value="@r" />
                    <button type="submit" class="btn @(r == BidResult.Won ? "btn-success" : r == BidResult.Lost ? "btn-danger" : "btn-outline-secondary")">@r.GetDisplayName()</button>
                }
            }
            @Html.ActionLink("Змінити ставку", "EditBid", new { id = pending.AuctionBidId }, new { @class = "btn btn-outline-primary" })
            @Html.ActionLink("До заявки", "Details", new { id = Model.OrderId }, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>
}
else
{
    <p class="text-muted small">
        Зробіть ставку на сайті аукціону й запишіть її тут. Ставка не може перевищувати бюджет клієнта
        @if (lastOutbid > 0)
        {
            <text>і має бути більшою за перебиту ($@lastOutbid.ToString("N0"))</text>
        }.
    </p>
    using (Html.BeginForm("PlaceBid", "Orders", new { id = Model.OrderId }, FormMethod.Post, new { @class = "card card-body" }))
    {
        @Html.AntiForgeryToken()
        @Html.Partial("_BidFields", form)
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Записати ставку</button>
            @Html.ActionLink("Скасувати", "Details", new { id = Model.OrderId }, new { @class = "btn btn-outline-secondary" })
        </div>
    }
}
