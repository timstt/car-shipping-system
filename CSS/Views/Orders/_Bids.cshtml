@model IEnumerable<AuctionBid>
@{
    var role = (UserRole)ViewBag.CurrentRole;
}
@* Історія ставок на аукціоні: бачать усі, хто має доступ до заявки *@
@if (Model.Any())
{
    <div class="card mb-3">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="fw-semibold">Аукціон: історія ставок</span>
            @* Загальна сторінка «Аукціони» доступна лише клієнту й менеджеру *@
            @if (role == UserRole.Client || role == UserRole.Manager)
            {
                @Html.ActionLink("Усі аукціони →", "Auctions", "Orders", null, new { @class = "small" })
            }
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr><th>Дата</th><th>Учасник</th><th>Аукціон</th><th>Лот</th><th class="text-end">Ставка</th><th>Результат</th>
                        @if (role == UserRole.Manager) { <th></th> }</tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td class="small">@b.PlacedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>Наша ставка</td>
                            <td>@b.Auction</td>
                            <td><a href="@b.LotUrl" target="_blank" rel="noopener noreferrer">@b.LotNumber</a></td>
                            <td class="text-end">$@b.Amount.ToString("N0")</td>
                            <td><span class="badge @AuctionBid.BadgeClass(b.Result)">@b.Result.GetDisplayName()</span></td>
                            @if (role == UserRole.Manager)
                            {
                                <td class="text-end">
                                    @* Кнопка лише там, де вилучення спрацює: ставка очікує результату, заявка в роботі *@
                                    @if (Manager.CanRemoveBid(b.Order, b))
                                    {
                                        using (Html.BeginForm("DeleteBid", "Orders", new { id = b.AuctionBidId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Вилучити цю ставку?');" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Вилучити</button>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                        @* Ставка іншого учасника, яка перебила нашу: аукціон не розкриває, хто це, тому лише сума *@
                        if (b.CompetitorAmount.HasValue)
                        {
                            <tr class="table-light text-muted">
                                <td class="small">—</td>
                                <td>Інший учасник</td>
                                <td>@b.Auction</td>
                                <td>@b.LotNumber</td>
                                <td class="text-end">$@b.CompetitorAmount.Value.ToString("N0")</td>
                                <td><span class="badge bg-dark">@(b.Result == BidResult.Lost ? "Купив авто" : "Перебив нашу")</span></td>
                                @if (role == UserRole.Manager) { <td></td> }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
