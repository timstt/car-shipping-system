@model AuctionBid
@{
    ViewBag.Title = "Змінити ставку — заявка №" + Model.OrderId;
}

<h1 class="h3 mb-3">Змінити ставку за заявкою №@Model.OrderId</h1>
<p class="text-muted small">Бюджет клієнта: $@Model.Order.MaxBudget.ToString("N0"). Змінити можна лише ставку, яка очікує результату торгів.</p>

@using (Html.BeginForm("EditBid", "Orders", new { id = Model.AuctionBidId }, FormMethod.Post, new { @class = "card card-body" }))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_BidFields", Model)
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Зберегти</button>
        @Html.ActionLink("Скасувати", "PlaceBid", new { id = Model.OrderId }, new { @class = "btn btn-outline-secondary" })
    </div>
}
