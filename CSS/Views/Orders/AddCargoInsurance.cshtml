@model Order
@{
    ViewBag.Title = "Страхування вантажу — заявка №" + Model.OrderId;
    var current = Model.Delivery.HasCargoInsurance ? Model.Delivery.CargoInsuranceCost : (Model.FinalPrice ?? 0) * 0.015;
}

<h1 class="h3 mb-3">Замовити додаткове страхування вантажу</h1>
<p class="text-muted">@(Model.Car != null ? Model.Car.GetDetails() : "")</p>

@using (Html.BeginForm("AddCargoInsurance", "Orders", new { id = Model.OrderId }, FormMethod.Post, new { @class = "card card-body" }))
{
    @Html.AntiForgeryToken()
    <label class="form-label" for="cost">Вартість страхування, $</label>
    <input type="number" class="form-control" id="cost" name="cost" min="1" step="1" value="@Math.Round(current)" required />
    <div class="form-text">За замовчуванням — 1,5% від ціни авто.</div>
    @Html.ValidationMessage("cost", "", new { @class = "text-danger small" })
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Оформити</button>
        @Html.ActionLink("Скасувати", "Details", new { id = Model.OrderId }, new { @class = "btn btn-outline-secondary" })
    </div>
}
