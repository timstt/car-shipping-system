@model Order
@{
    ViewBag.Title = "Фотозвіт — заявка №" + Model.OrderId;
}

<h1 class="h3 mb-3">Фотозвіт стану авто</h1>
<p class="text-muted">@(Model.Car != null ? Model.Car.GetDetails() : "")</p>

@using (Html.BeginForm("AddPhotoReport", "Orders", new { id = Model.OrderId }, FormMethod.Post, new { @class = "card card-body" }))
{
    @Html.AntiForgeryToken()
    <label class="form-label" for="note">Опис стану авто (посилання на фото, пошкодження тощо)</label>
    <textarea class="form-control" id="note" name="note" rows="5" required>@Model.Delivery.PhotoReportNote</textarea>
    @Html.ValidationMessage("note", "", new { @class = "text-danger small" })
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Зберегти</button>
        @Html.ActionLink("Скасувати", "Details", new { id = Model.OrderId }, new { @class = "btn btn-outline-secondary" })
    </div>
}
