@model IEnumerable<AuctionBid>
@{
    var role = (UserRole)ViewBag.CurrentRole;
    BidResult? selected = ViewBag.Result;
    var counts = (Dictionary<BidResult, int>)ViewBag.Counts;
    double wonSum = ViewBag.WonSum;
    Func<BidResult, int> count = r => counts.ContainsKey(r) ? counts[r] : 0;
    ViewBag.Title = "Історія аукціонів";
}

<h1 class="h3 mb-3">Історія аукціонів</h1>

@* Підсумок: скільки ставок виграно, програно, перебито й очікує результату *@
<div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
        <div class="card text-center border-success h-100"><div class="card-body py-2">
            <div class="small text-muted">Виграно</div>
            <div class="fs-4 fw-semibold text-success">@count(BidResult.Won)</div>
            <div class="small text-muted">на суму $@wonSum.ToString("N0")</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-danger h-100"><div class="card-body py-2">
            <div class="small text-muted">Програно</div>
            <div class="fs-4 fw-semibold text-danger">@count(BidResult.Lost)</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center h-100"><div class="card-body py-2">
            <div class="small text-muted">Перебито</div>
            <div class="fs-4 fw-semibold">@count(BidResult.Outbid)</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-warning h-100"><div class="card-body py-2">
            <div class="small text-muted">Очікують результату</div>
            <div class="fs-4 fw-semibold">@count(BidResult.Pending)</div>
        </div></div>
    </div>
</div>

@using (Html.BeginForm("Auctions", "Orders", FormMethod.Get, new { @class = "row g-2 align-items-end mb-3" }))
{
    <div class="col-auto">
        <label class="form-label small" for="result">Результат</label>
        <select class="form-select" id="result" name="result">
            <option value="">Усі</option>
            @foreach (BidResult r in Enum.GetValues(typeof(BidResult)))
            {
                <option value="@r" selected="@(selected == r)">@r.GetDisplayName()</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Фільтрувати</button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary">Ставок на аукціонах ще немає.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Дата</th>
                    <th>Заявка</th>
                    @if (role == UserRole.Manager) { <th>Клієнт</th> }
                    <th>Авто</th>
                    <th>Аукціон</th>
                    <th>Лот</th>
                    <th class="text-end">Наша ставка, $</th>
                    <th class="text-end">Інший учасник, $</th>
                    <th>Результат</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    var car = b.Order.Car;
                    <tr>
                        <td class="small">@b.PlacedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@Html.ActionLink("№" + b.OrderId, "Details", new { id = b.OrderId })</td>
                        @if (role == UserRole.Manager) { <td>@(b.Order.Client != null ? b.Order.Client.Name : "—")</td> }
                        <td>@(car != null ? car.Make + " " + car.Model + " (" + car.Year + ")" : "—")</td>
                        <td>@b.Auction</td>
                        <td><a href="@b.LotUrl" target="_blank" rel="noopener noreferrer">@b.LotNumber</a></td>
                        <td class="text-end">@b.Amount.ToString("N0")</td>
                        <td class="text-end">@(b.CompetitorAmount.HasValue ? b.CompetitorAmount.Value.ToString("N0") : "—")</td>
                        <td><span class="badge @AuctionBid.BadgeClass(b.Result)">@b.Result.GetDisplayName()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
