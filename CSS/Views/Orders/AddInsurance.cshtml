@model Insurance
@{
    var order = (Order)ViewBag.Order;
    ViewBag.Title = "Страховий пакет — заявка №" + order.OrderId;
}

<h1 class="h3 mb-3">Додати страховий пакет до заявки №@order.OrderId</h1>

@using (Html.BeginForm("AddInsurance", "Orders", new { id = order.OrderId }, FormMethod.Post, new { @class = "card card-body" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row g-3">
        <div class="col-md-8">
            @Html.LabelFor(m => m.Type, new { @class = "form-label" })
            <select class="form-select" id="Type" name="Type">
                @foreach (var t in new[] { "Базове (КАСКО на час перевезення)", "Розширене (КАСКО + пошкодження в порту)", "Повне (усі ризики)" })
                {
                    <option value="@t" selected="@(Model.Type == t)">@t</option>
                }
            </select>
            @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.Price, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", min = "1", step = "1" })
            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger small" })
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-success">Додати</button>
        @Html.ActionLink("Скасувати", "Details", new { id = order.OrderId }, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
