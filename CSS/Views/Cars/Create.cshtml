@model Car
@{
    ViewBag.Title = "Додати авто";
}

<h1 class="h3 mb-3">Додати авто до каталогу</h1>
<p class="text-muted">Нове авто отримує статус «Доступно».</p>

@using (Html.BeginForm("Create", "Cars", FormMethod.Post, new { @class = "card card-body" }))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_CarForm", Model)
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-success">Додати</button>
        @Html.ActionLink("Скасувати", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
