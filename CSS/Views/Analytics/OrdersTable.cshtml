@using ASTCUSA.Models.Analytics
@model IList<OrderTableRow>
@{
    ViewBag.Title = "Аналітика — таблиця заявок";
}

@Html.Partial("_AnalyticsNav")
<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted">Усього заявок: @Model.Count</span>
    @Html.ActionLink("Додати заявку", "CreateOrder", null, new { @class = "btn btn-success" })
</div>
<div class="table-responsive">
    <table class="table table-sm table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th><th>Дата</th><th>Клієнт</th><th>Менеджер</th><th>Авто</th>
                <th class="text-end">Бюджет, $</th><th class="text-end">Підсумок, $</th><th>Статус</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.OrderId</td><td>@o.CreatedAt.ToString("dd.MM.yyyy")</td><td>@o.ClientName</td>
                    <td>@(o.ManagerName ?? "—")</td><td>@(o.Make == null ? "—" : o.Make + " " + o.Model)</td>
                    <td class="text-end">@o.MaxBudget.ToString("N2")</td>
                    <td class="text-end">@(o.FinalPrice.HasValue ? o.FinalPrice.Value.ToString("N2") : "—")</td>
                    <td>@AnalyticsText.OrderStatusName(o.Status)</td>
                    <td class="text-nowrap">
                        @Html.ActionLink("Змінити", "EditOrder", new { id = o.OrderId }, new { @class = "btn btn-sm btn-outline-primary" })
                        @using (Html.BeginForm("DeleteOrder", "Analytics", new { id = o.OrderId }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Видалити заявку №" + o.OrderId + "?');" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Видалити</button>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="9" class="text-muted">Заявок немає</td></tr>
            }
        </tbody>
    </table>
</div>
