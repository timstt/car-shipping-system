@using ASTCUSA.Models.Analytics
@model UserInput
@{
    bool isNew = !Model.Id.HasValue;
    ViewBag.Title = isNew ? "Аналітика — новий користувач" : "Аналітика — зміна користувача";
}

@Html.Partial("_AnalyticsNav")

@using (Html.BeginForm(isNew ? "CreateUser" : "EditUser", "Analytics", FormMethod.Post, new { @class = "card card-body mb-3" }))
{
    @Html.AntiForgeryToken()
    <h2 class="h5">@(isNew ? "Новий користувач" : "Зміна користувача №" + Model.Id)</h2>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    if (!isNew)
    {
        @Html.HiddenFor(m => m.Id)
    }
    <div class="row g-2 align-items-start">
        <div class="col-md-4">
            @Html.LabelFor(m => m.Name, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-5">
            @Html.LabelFor(m => m.Email, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.Role, new { @class = "form-label small" })
            @Html.DropDownListFor(m => m.Role, (SelectList)ViewBag.Roles, "— оберіть роль —", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Role, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "+380..." })
            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-8">
            @Html.LabelFor(m => m.Address, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(isNew ? "Додати" : "Зберегти")</button>
        @Html.ActionLink("Скасувати", "UsersTable", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
