@using ASTCUSA.Models.Analytics
@model ParallelPage
@{
    ViewBag.Title = "Аналітика — паралелізм";
    var report = Model.Report;
}

@Html.Partial("_AnalyticsNav")

<div class="card card-body mb-3">
    <h2 class="h5">Паралельна обробка даних (таблиця Users)</h2>
    <p class="mb-2">
        Запит: <strong>клієнти-абоненти Київстар (+380 67/68/96/97/98) з коректним латинським e-mail</strong>.
        Записи один раз читаються з бази, далі той самий запит виконується послідовно і паралельно,
        кожен спосіб 10 разів після прогрівного запуску.
    </p>
    <div class="d-flex flex-wrap gap-4 mb-3">
        <span>Записів у таблиці: <strong>@Model.TotalUsers.ToString("N0")</strong></span>
        <span>З них згенеровано: <strong>@Model.GeneratedUsers.ToString("N0")</strong></span>
        <span>Логічних ядер процесора: <strong>@Model.ProcessorCount</strong></span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @using (Html.BeginForm("RunParallel", "Analytics", FormMethod.Post, new { @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">Виконати заміри</button>
        }
        @using (Html.BeginForm("FillUsers", "Analytics", FormMethod.Post, new { @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">Заповнити до @UsersGenerator.TargetCount.ToString("N0") записів</button>
        }
        @using (Html.BeginForm("RemoveGeneratedUsers", "Analytics", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Видалити всі згенеровані записи?');" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger" @(Model.GeneratedUsers == 0 ? "disabled" : "")>Видалити згенеровані</button>
        }
    </div>
</div>

@if (report != null)
{
    bool allCorrect = report.Rows.All(r => r.Found == report.ExpectedFound);
    <div class="mb-2">
        Записів у вибірці: <strong>@report.RowCount.ToString("N0")</strong>;
        читання з бази: <strong>@report.LoadMs.ToString("N0") мс</strong>;
        знайдено запитом: <strong>@report.ExpectedFound.ToString("N0")</strong>
        <span class="@(allCorrect ? "text-success" : "text-danger")">
            (@(allCorrect ? "усі способи повернули однаковий результат" : "результати способів відрізняються!"))
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-striped w-auto">
            <thead>
                <tr>
                    <th>Технологія</th><th>Спосіб</th><th class="text-end">Потоків / ядер</th>
                    <th class="text-end">Середній час, мс</th><th class="text-end">Мін. час, мс</th>
                    <th class="text-end">Прискорення</th><th class="text-end">Знайдено</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in report.Rows)
                {
                    <tr>
                        <td>@r.Technology</td><td>@r.Method</td><td class="text-end">@r.Threads</td>
                        <td class="text-end">@r.AverageMs.ToString("N3")</td>
                        <td class="text-end">@r.MinMs.ToString("N3")</td>
                        <td class="text-end @(r.Speedup >= 1 ? "text-success" : "text-danger")">×@r.Speedup.ToString("N2")</td>
                        <td class="text-end">@r.Found.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="small text-muted">
        Прискорення = середній час послідовного запиту / середній час способу. Значення менше 1 означає,
        що паралельний спосіб повільніший: витрати на створення й синхронізацію потоків більші за саму роботу.
    </p>
}
