@using ASTCUSA.Models.Analytics
@model CarInput
@{
    bool isNew = !Model.CarId.HasValue;
    ViewBag.Title = isNew ? "Аналітика — нове авто" : "Аналітика — зміна авто";
}

@Html.Partial("_AnalyticsNav")

@using (Html.BeginForm(isNew ? "CreateCar" : "EditCar", "Analytics", FormMethod.Post, new { @class = "card card-body mb-3" }))
{
    @Html.AntiForgeryToken()
    <h2 class="h5">@(isNew ? "Нове авто" : "Зміна авто №" + Model.CarId)</h2>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    if (!isNew)
    {
        @Html.HiddenFor(m => m.CarId)
    }
    <div class="row g-2 align-items-start">
        <div class="col-md-4">
            @Html.LabelFor(m => m.VinCode, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.VinCode, new { @class = "form-control", maxlength = "17" })
            @Html.ValidationMessageFor(m => m.VinCode, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.Make, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.Make, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Make, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.Model, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.Model, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Model, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.Year, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.Year, new { @class = "form-control", inputmode = "numeric" })
            @Html.ValidationMessageFor(m => m.Year, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.AuctionPrice, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.AuctionPrice, new { @class = "form-control", inputmode = "decimal" })
            @Html.ValidationMessageFor(m => m.AuctionPrice, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-5">
            @Html.LabelFor(m => m.Status, new { @class = "form-label small" })
            @Html.DropDownListFor(m => m.Status, (SelectList)ViewBag.Statuses, "— оберіть статус —", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger small" })
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(isNew ? "Додати" : "Зберегти")</button>
        @Html.ActionLink("Скасувати", "CarsTable", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
