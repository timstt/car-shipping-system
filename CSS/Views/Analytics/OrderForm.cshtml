@using ASTCUSA.Models.Analytics
@model OrderInput
@{
    bool isNew = !Model.OrderId.HasValue;
    ViewBag.Title = isNew ? "Аналітика — нова заявка" : "Аналітика — зміна заявки";
}

@Html.Partial("_AnalyticsNav")

@using (Html.BeginForm(isNew ? "CreateOrder" : "EditOrder", "Analytics", FormMethod.Post, new { @class = "card card-body mb-3" }))
{
    @Html.AntiForgeryToken()
    <h2 class="h5">@(isNew ? "Нова заявка" : "Зміна заявки №" + Model.OrderId)</h2>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    if (!isNew)
    {
        @Html.HiddenFor(m => m.OrderId)
    }
    <div class="row g-2 align-items-start">
        <div class="col-md-4">
            @Html.LabelFor(m => m.ClientId, new { @class = "form-label small" })
            @Html.DropDownListFor(m => m.ClientId, (SelectList)ViewBag.Clients, "— оберіть клієнта —", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.ClientId, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.ManagerId, new { @class = "form-label small" })
            @Html.DropDownListFor(m => m.ManagerId, (SelectList)ViewBag.Managers, "— не призначено —", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.ManagerId, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.CarId, new { @class = "form-label small" })
            @Html.DropDownListFor(m => m.CarId, (SelectList)ViewBag.Cars, "— не обрано —", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.CarId, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.MaxBudget, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.MaxBudget, new { @class = "form-control", inputmode = "decimal" })
            @Html.ValidationMessageFor(m => m.MaxBudget, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.FinalPrice, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.FinalPrice, new { @class = "form-control", inputmode = "decimal" })
            @Html.ValidationMessageFor(m => m.FinalPrice, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.Status, new { @class = "form-label small" })
            @Html.DropDownListFor(m => m.Status, (SelectList)ViewBag.Statuses, "— оберіть статус —", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger small" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.CreatedAt, new { @class = "form-label small" })
            @Html.TextBoxFor(m => m.CreatedAt, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.CreatedAt, "", new { @class = "text-danger small" })
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(isNew ? "Додати" : "Зберегти")</button>
        @Html.ActionLink("Скасувати", "OrdersTable", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
