@{
    ViewBag.Title = "Головна";
    var role = User.Identity.GetUserRole();
}

<div class="p-4 mb-4 bg-light rounded-3">
    <h1 class="h3">Система перевезення авто зі США</h1>
    <p class="lead mb-0">Підбір авто на аукціонах, оплата, доставка і розмитнення в одному місці.</p>
</div>

@if (role == UserRole.None)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card h-100"><div class="card-body">
            <h2 class="h6">Клієнтам</h2>
            <p class="text-muted small mb-0">Каталог авто з аукціонів США, заявка на підбір у межах бюджету, страхування,
                оплата інвойсу та відстеження доставки до отримання авто.</p>
        </div></div></div>
        <div class="col-md-4"><div class="card h-100"><div class="card-body">
            <h2 class="h6">Менеджерам</h2>
            <p class="text-muted small mb-0">Обробка заявок, участь в аукціонах, формування інвойсів, контроль оплати й звітність.</p>
        </div></div></div>
        <div class="col-md-4"><div class="card h-100"><div class="card-body">
            <h2 class="h6">Логістам</h2>
            <p class="text-muted small mb-0">Призначення перевізника, митні документи, доручення, страхування вантажу і статус доставки.</p>
        </div></div></div>
    </div>
    <div class="d-flex gap-2">
        @Html.ActionLink("Увійти", "Login", "Account", null, new { @class = "btn btn-primary" })
        @Html.ActionLink("Зареєструватися", "Register", "Account", null, new { @class = "btn btn-outline-primary" })
    </div>
    <p class="mt-3 small text-muted">Самостійно зареєструватися можна як клієнт. Облікові записи менеджерів і логістів створюються в системі заздалегідь.</p>
}
else
{
    <h2 class="h5 mb-3">Вітаємо, @User.Identity.GetDisplayName()!</h2>

    if (role == UserRole.Client)
    {
        if (!string.IsNullOrEmpty(ViewBag.Notification as string))
        {
            <div class="alert alert-warning"><strong>Сповіщення:</strong> @ViewBag.Notification</div>
        }
        <div class="row g-3">
            <div class="col-md-4"><div class="card h-100"><div class="card-body">
                <h3 class="h6">Каталог авто</h3>
                <p class="text-muted small">Пошук за маркою, моделлю, роком і ціною. Додавайте авто в обране.</p>
                @Html.ActionLink("Переглянути каталог", "Index", "Cars", null, new { @class = "btn btn-primary btn-sm" })
            </div></div></div>
            <div class="col-md-4"><div class="card h-100"><div class="card-body">
                <h3 class="h6">Мої заявки (@ViewBag.MyOrders)</h3>
                <p class="text-muted small">Оплата інвойсів, відстеження доставки, підтвердження отримання.</p>
                @Html.ActionLink("Відкрити заявки", "Index", "Orders", null, new { @class = "btn btn-primary btn-sm" })
            </div></div></div>
            <div class="col-md-4"><div class="card h-100"><div class="card-body">
                <h3 class="h6">Нова заявка</h3>
                <p class="text-muted small">Оберіть авто і вкажіть максимальний бюджет.</p>
                @Html.ActionLink("Створити заявку", "Create", "Orders", null, new { @class = "btn btn-success btn-sm" })
            </div></div></div>
        </div>
    }
    else if (role == UserRole.Manager)
    {
        <div class="row g-3">
            <div class="col-md-4"><div class="card h-100"><div class="card-body">
                <h3 class="h6">Нові заявки: @ViewBag.NewOrders</h3>
                <p class="text-muted small">Оплата чекає підтвердження: @ViewBag.WaitingPayment</p>
                @Html.ActionLink("Заявки", "Index", "Orders", null, new { @class = "btn btn-primary btn-sm" })
            </div></div></div>
            <div class="col-md-4"><div class="card h-100"><div class="card-body">
                <h3 class="h6">Каталог авто</h3>
                <p class="text-muted small">Додавання, редагування та видалення авто.</p>
                @Html.ActionLink("Каталог", "Index", "Cars", null, new { @class = "btn btn-primary btn-sm" })
            </div></div></div>
            <div class="col-md-4"><div class="card h-100"><div class="card-body">
                <h3 class="h6">Звітність</h3>
                <p class="text-muted small">Зведення заявок за період і експорт у CSV (Excel).</p>
                @Html.ActionLink("Сформувати звіт", "Index", "Reports", null, new { @class = "btn btn-primary btn-sm" })
            </div></div></div>
        </div>
    }
    else if (role == UserRole.Logistician)
    {
        <div class="row g-3">
            <div class="col-md-6"><div class="card h-100"><div class="card-body">
                <h3 class="h6">Оплачені заявки (до відправлення): @ViewBag.PaidOrders</h3>
                <p class="text-muted small">У дорозі: @ViewBag.Shipping</p>
                @Html.ActionLink("Доставки", "Index", "Orders", null, new { @class = "btn btn-primary btn-sm" })
            </div></div></div>
        </div>
    }

}
