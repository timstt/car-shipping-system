@using ASTCUSA.Models.Lab3
@model InsuranceInput
@{
    ViewBag.Title = "БД і LINQ — зміна страховки";
}

@Html.Partial("_Lab3Nav")

@using (Html.BeginForm("EditInsurance", "Lab3", FormMethod.Post, new { @class = "card card-body mb-3" }))
{
    @Html.AntiForgeryToken()
    <h2 class="h5">Зміна страховки №@Model.InsuranceId</h2>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <input type="hidden" name="InsuranceId" value="@Model.InsuranceId" />
    @Html.Partial("_InsuranceFields", Model)
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Зберегти</button>
        @Html.ActionLink("Скасувати", "Insurances", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
